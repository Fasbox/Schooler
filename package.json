{
  "name": "schooler",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "npm@11.4.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev -w @schooler/web\" \"npm run dev -w @schooler/api\"",
    "dev:web": "npm run dev -w @schooler/web",
    "dev:api": "npm run dev -w @schooler/api",
    "build": "npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test -ws --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}
